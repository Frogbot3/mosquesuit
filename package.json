{
  "name": "mosque-suite",
  "productName": "Mosque Suite",
  "version": "0.8.0-rc.1",
  "description": "Offline mosque administration ? unsigned Windows testing candidate",
  "author": "Mosque Suite",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron && npm run build:service",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/start.mjs",
    "demo:events": "node scripts/start.mjs --life-events-demo",
    "postinstall": "node scripts/verify-native.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run check:localization && npm run test && npm run test:e2e",
    "pack:win": "npm run build:release && electron-builder --win --x64 --dir",
    "dist:win": "npm run build:release && electron-builder --win nsis --x64",
    "test:packaged": "node scripts/test-packaged.mjs",
    "demo:finance": "node scripts/start.mjs --finance-demo",
    "demo:integrations": "node scripts/start.mjs --integrations-demo",
    "build:service": "node scripts/build-service.mjs",
    "service:mock": "node scripts/service.mjs",
    "demo:security": "node scripts/start.mjs --security-demo",
    "lint": "eslint . --max-warnings 0",
    "check:localization": "node scripts/check-localization.mjs",
    "qa:benchmark": "node scripts/qa.mjs benchmark",
    "qa:seed": "node scripts/qa.mjs seed",
    "qa:pilot-data": "node scripts/qa.mjs pilot-data",
    "qa:load": "npm run build && playwright test --config playwright.load.config.ts",
    "demo:pilot": "node scripts/start-pilot.mjs",
    "qa:package": "node scripts/package-pilot.mjs",
    "preview:release": "node scripts/start.mjs --release-preview",
    "build:release": "npm run build && node scripts/release-build.mjs",
    "dist:signed": "node scripts/release-build.mjs --signed"
  },
  "build": {
    "appId": "org.mosquesuite.desktop",
    "productName": "Mosque Suite",
    "artifactName": "MosqueSuite-Unsigned-Testing-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release/windows-testing"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@node-rs/argon2*/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createStartMenuShortcut": true,
      "shortcutName": "Mosque Suite Testing",
      "allowElevation": false,
      "packElevateHelper": false
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-table": "8.21.3",
    "better-sqlite3": "13.0.3",
    "exceljs": "4.4.0",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.10",
    "@babel/eslint-parser": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": false,
    "electron-winstaller@5.4.0": false
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
